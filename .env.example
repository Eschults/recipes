# Copy to .env and fill in. `npm run add-recipe` loads it automatically;
# .env is git-ignored, this file is not.

# Used to read the caption. Create a key at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Where Cookbook's RecipeMD parser lives. Only needed when Cookbook is not
# checked out next to this repository.
# COOKBOOK_DIR=../cookbook
