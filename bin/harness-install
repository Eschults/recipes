#!/usr/bin/env bash
# Installs the harness into the current repo: fetches the workflow,
# prompts, harness rules, and the bin/ tooling, then wires
# harness-rules.md into CLAUDE.md. Safe to re-run.
set -euo pipefail
cd "$(dirname "$0")/.."

mkdir -p .github/workflows .claude/prompts bin/lib

src=${HARNESS_SRC:-https://raw.githubusercontent.com/Eschults/harness/v1}
curl -fsSL "$src/bin/lib/fetch-files.sh" -o bin/lib/fetch-files.sh
# shellcheck source=bin/lib/fetch-files.sh
source bin/lib/fetch-files.sh

fetch_harness_files
curl -fsSL "$src/bin/harness-upgrade" -o bin/harness-upgrade
chmod +x bin/harness-upgrade

if ! grep -qF '@.claude/harness-rules.md' CLAUDE.md 2>/dev/null; then
  printf '\n@.claude/harness-rules.md\n' >> CLAUDE.md
fi

echo "Installed the harness at $(cat .claude/HARNESS_VERSION). See README.md for the routine, label, and repo value steps."
